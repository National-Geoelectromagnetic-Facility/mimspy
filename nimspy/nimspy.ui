        <font>
         <pointsize>13</pointsize>
        </font>
       </property>
       <property name="text">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;EGINEERING MODE reveals the binary data packet streaming from the NIMS each second.&lt;/p&gt;&lt;p&gt;Each 25-byte data packet has the same order of bytes, numbered 0 through 24, beginning with a h01 and ending with a h04. ('h' means Hex display)&lt;/p&gt;&lt;p&gt;ENGINEERING MODE  enables the User to bypass the filters of the GUI and see the NIMS communication directly.  It can be helpful.&lt;/p&gt;&lt;p&gt;Frequently used bytes are displayed separately but can still be found in the original 25-byte packet.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
